function run() {
  if (!fs.existsSync(EXAMPLES_ROOT)) {
    throw new Error('examples directory does not exist');
  }

  const tempRoot = fs.mkdtempSync(nodePath.join(os.tmpdir(), 'devkit-examples-'));
  const workExamplesDir = nodePath.join(tempRoot, 'examples');

  try {
    fs.cpSync(EXAMPLES_ROOT, workExamplesDir, {recursive: true});
    ensureAliasLinks(workExamplesDir);

    const entries = listExampleEntries(workExamplesDir);
    if (entries.length === 0) {
      throw new Error('No example entry files found.');
    }

    const compiledByEntry = new Map();
    for (const entryPath of entries) {
      const relative = toPosix(nodePath.relative(workExamplesDir, entryPath));
      const code = compileWithProjectPipeline(entryPath);
      compiledByEntry.set(relative, code);
    }

    console.log(`[examples] compiled ${compiledByEntry.size} entry files`);

    const checks = runtimeChecks();
    for (const [entry, check] of checks.entries()) {
      const code = compiledByEntry.get(entry);
      if (!code) {
        throw new Error(`Runtime check references missing compiled entry: ${entry}`);
      }
      const runtimeGlobal = executeCompiled(entry, code);
      try {
        check(runtimeGlobal);
      } catch (error) {
        throw new Error(`Runtime assertion failed for ${entry}: ${error.message}`);
      }
    }

    console.log(`[examples] runtime checks passed for ${checks.size} entries`);

    const compileTimeEntry = nodePath.join(workExamplesDir, 'command_system', '06_compile_time_value_intermediate.ts');
    const macroOnly = compileMacroOnly(compileTimeEntry);

    if (!(macroOnly.code.length < macroOnly.source.length)) {
      throw new Error('compile-time VALUE example did not reduce transformed code size (macro-only check).');
    }
    if (macroOnly.code.includes('compileOnlyPolicyDraft')) {
      throw new Error('compile-time VALUE example still contains compile-only identifier after macro transform.');
    }
    if (macroOnly.code.includes('@lib/command_system/builder')) {
      throw new Error('compile-time VALUE example still imports builder module after macro transform.');
    }
    if (!macroOnly.code.includes('@lib/command_system/runtime')) {
      throw new Error('compile-time VALUE example unexpectedly dropped runtime import.');
    }

    console.log('[examples] compile-time VALUE reduction checks passed');
  } finally {
    fs.rmSync(tempRoot, {recursive: true, force: true});
  }
}

try {
  run();
} catch (error) {
  console.error('[examples] validation failed');
  console.error(error && error.stack ? error.stack : String(error));
  process.exitCode = 1;
}
